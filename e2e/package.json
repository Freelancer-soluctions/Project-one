{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "main": "playwright.config.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "lint": "eslint \"tests/**/*.js\" playwright.config.js --max-warnings 0 --cache --cache-location .cache/eslint/ --cache-strategy content",
    "format": "prettier --write \"**/*.{js,json,md}\" \"!test-results/**\" \"!playwright-report/**\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\" \"!test-results/**\" \"!playwright-report/**\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
