{
  "name": "project-one",
  "description": "Front end \r - Persitencia de datos como el inicio de sesion con redux-persist\r - Proteccion de rutas solo accesibles cuando la sesion es valida por medio de un guard, trabajando conjuntamente con jwt\r - Internalizacion con i18next y react-i18next soportando dos idiomas (ingles y español)\r - Storybook para la documentacion y prueba componentes UI, para la facilitacion entre diseñadores y QA testers\r - Uso de hooks personalizados para organizar y separalar la logica de la pagina para su mejor comprension.\r - Uso de logger para monitoreo y registro de acciones o errores del front end\r - React hook forma para manejo de formularios en combinacion con zod schema validation\r - RTK QUERY  para manejo de estado global\r - Redux persist para la persitencia de estados necesarios como lo son las configuraciones o informacion de usuario",
  "homepage": "https://github.com/Freelancer-soluctions/Project-one#readme",
  "bugs": {
    "url": "https://github.com/Freelancer-soluctions/Project-one/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freelancer-soluctions/Project-one.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=22.11",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "husky:disable": "ren .husky .husky.disabled",
    "husky:enable": "ren .husky.disabled .husky",
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev --workspace=client-react\" \"npm run dev --workspace=server-express\"",
    "dev:client": "npm run dev --workspace=client-react",
    "dev:server": "npm run dev --workspace=server-express",
    "test": "npm run test --workspaces --if-present",
    "test:all": "concurrently -m 1 --success first -n unit,integration,e2e -c cyan,yellow,green \"npm --prefix apps/server-express run test:unit\" \"npm --prefix apps/server-express run test:integration\" \"npm --prefix e2e run test\"",
    "test:unit:all": "concurrently -m 1 --success first -n server,client -c green,cyan \"npm run test:unit --workspace=server-express\" \"npm run test:unit --workspace=client-react\"",
    "test:integration:all": "npm run test:integration --workspace=server-express",
    "test:e2e:all": "npm --prefix e2e run test",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:changed": "npm run test:changed --workspaces --if-present",
    "test:ci": "npm run test --workspaces --if-present -- --reporter=junit",
    "test:server": "npm run test --workspace=server-express",
    "test:client": "npm run test --workspace=client-react",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:smoke": "npm run test:smoke --workspace=server-express",
    "test:smoke:ci": "npm run test:smoke:ci --workspace=server-express",
    "test:regression": "npm run test:regression --workspace=server-express",
    "verify:e2e": "npm --prefix e2e run test -- --reporter=list",
    "verify:smoke": "npm run test:smoke --workspace=server-express -- --reporter=list",
    "test:debug": "node --import why-is-node-running/include node_modules/vitest/vitest.mjs run --config apps/server/vitest.config.js",
    "build": "npm run build --ws --if-present",
    "prepush": "concurrently -m 1 --success first -n test,build -c cyan,green \"npm run test:changed --workspace=server-express\" \"npm run test:changed --workspace=client-react\" \"npm run build --workspace=client-react\"",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "sast:semgrep": "powershell -ExecutionPolicy Bypass -File scripts/security/semgrep-staged.ps1",
    "sast:semgrep:full": "powershell -ExecutionPolicy Bypass -File scripts/security/semgrep.ps1",
    "security:secrets": "gitleaks git --pre-commit --staged --verbose --redact --config .gitleaks.toml",
    "security:secrets:full": "gitleaks git --verbose --config .gitleaks.toml",
    "security:trivy:deps": "powershell -ExecutionPolicy Bypass -File scripts/security/dependency-scan.ps1",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --ignore-scripts",
    "release": "changeset git-tag",
    "check:manifest": "node scripts/check-root-manifest.mjs",
    "pr:title-check": "node scripts/hooks/pr-title-check.js",
    "pr:create": "node scripts/hooks/pr-create.js",
    "knip": "knip",
    "knip:client": "knip --workspace=apps/client",
    "knip:server": "knip --workspace=apps/server",
    "knip:ci": "knip --no-progress --reporter json",
    "depcruise": "depcruise apps/client/src apps/server/src e2e/tests --config .dependency-cruiser.cjs",
    "depcruise:client": "depcruise apps/client/src --config .dependency-cruiser.cjs",
    "depcruise:server": "depcruise apps/server/src --config .dependency-cruiser.cjs",
    "depcruise:ci": "npm run depcruise -- --output-type err --ignore-known",
    "depcruise:report": "npm run depcruise -- --output-type err-html -f reports/dependency-cruiser.html --ignore-known",
    "depcruise:baseline": "depcruise-baseline apps/client/src apps/server/src e2e/tests --config .dependency-cruiser.cjs",
    "type-check": "tsc --noEmit -p apps/server",
    "docs:lint": "markdownlint \"docs/**/*.md\" \"docs/*.md\"",
    "docs:vale": "vale --config .vale.ini --minAlertLevel=error docs/"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "9.39.5",
    "@fission-ai/openspec": "1.13.1",
    "@vitest/eslint-plugin": "^1.6.9",
    "actionlint": "2.0.6",
    "concurrently": "^9.1.0",
    "depcheck": "1.4.7",
    "dependency-cruiser": "18.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^0.11.0",
    "globals": "14.0.0",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.5",
    "knip": "6.32.2",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.49.1",
    "omniroute": "3.8.50",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "why-is-node-running": "2.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,jsonc,md}": "prettier --write",
    "*.{js,jsx,cjs,mjs}": "eslint --fix --max-warnings 0 --no-warn-ignored",
    "*.{js,jsx,ts,tsx,cjs,mjs}": "depcruise --config .dependency-cruiser.cjs --output-type err-long --ignore-known=.dependency-cruiser-known-violations.json"
  },
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "keywords": []
}
