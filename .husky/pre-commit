#!/usr/bin/env sh
# Pre-commit hook: SAST + Secrets + Regression tests (all in parallel)

set -e

echo "🔍 Running pre-commit checks in parallel..."

# Start SAST scan in background
echo "🔬 Starting SAST scan..."
npm run sast:semgrep &
SAST_PID=$!

# Start secret detection in background
echo "🔐 Starting secret detection..."
npm run security:secrets &
SECRETS_PID=$!

# Start regression tests in background
echo "🧪 Starting regression tests..."
npm run test:regression &
REGRESSION_PID=$!

# Wait for all and capture exit codes
FAILED=0

wait $SAST_PID || { echo "❌ SAST scan failed."; FAILED=1; }
wait $SECRETS_PID || { echo "❌ Secret scan failed."; FAILED=1; }
wait $REGRESSION_PID || { echo "❌ Regression tests failed."; FAILED=1; }

if [ $FAILED -ne 0 ]; then
  echo "❌ Pre-commit checks failed. Commit blocked."
  exit 1
fi

echo "✅ All pre-commit checks passed (SAST, Secrets, Regression)."