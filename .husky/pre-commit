#!/usr/bin/env sh
# Pre-commit hook: lint-staged + Secrets + CI-parity advisory layers (blocking when tool available)

set -e

echo "🔍 Running pre-commit checks..."

# 1. lint-staged first (fast, may modify files via autofix)
echo "🔧 Running lint-staged..."
NODE_OPTIONS="--max-old-space-size=4096" npm exec lint-staged -- --concurrent=false || { echo "❌ lint-staged failed"; exit 1; }

# 2. Secret detection staged-only
echo "🔐 Starting secret detection (staged content only)..."
if ! command -v gitleaks > /dev/null 2>&1; then
  echo "⚠️  gitleaks binary not found in PATH — NO secret scan ran for this commit."
  echo "   Fail-open policy: the commit proceeds (tooling problem, not a finding)."
else
  SECRETS_OUT=$(npm run security:secrets 2>&1) && SECRETS_EXIT=0 || SECRETS_EXIT=$?
  if [ "$SECRETS_EXIT" -eq 0 ]; then
    echo "✅ Staged secret scan passed."
  elif [ "$SECRETS_EXIT" -eq 1 ]; then
    echo "$SECRETS_OUT"
    echo "❌ Staged secret detected — commit blocked."
    exit 1
  else
    echo "$SECRETS_OUT"
    echo "⚠️  Secret scanner failed (exit $SECRETS_EXIT) — NO secret scan ran."
  fi
fi

# 3. CI-parity layers: blocking when the tool is available, fail-open if missing.
echo "🧱 Checkov IaC..."
if command -v checkov >/dev/null 2>&1; then checkov -d . --config-file .checkov.yml; else echo "⚠️  checkov not installed — skipping"; fi

echo "🐳 Hadolint Containerfile..."
if command -v hadolint >/dev/null 2>&1; then hadolint -c .hadolint.yaml --failure-threshold warning apps/server/Dockerfile; else echo "⚠️  hadolint not installed — skipping"; fi

echo "🔧 ActionLint workflows..."
if command -v actionlint >/dev/null 2>&1; then actionlint -config-file .github/actionlint.yaml; else echo "⚠️  actionlint not installed — skipping"; fi

echo "🛡️ Zizmor workflows..."
if command -v zizmor >/dev/null 2>&1; then zizmor -c .github/zizmor.yml .github/workflows/; else echo "⚠️  zizmor not installed — skipping"; fi

echo "📦 Root manifest hygiene..."
node scripts/check-root-manifest.mjs

echo "🐍 GuardDog typosquat..."
if command -v bash >/dev/null 2>&1; then bash scripts/guarddog-verify.sh > .tmp/guarddog.sarif 2>/dev/null || echo "⚠️  guarddog not available or findings — see .tmp/guarddog.sarif"; fi

echo "✅ All pre-commit checks passed."
