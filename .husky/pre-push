#!/bin/sh
set -e

# Fetch latest origin/main for accurate diff base
echo "Fetching latest origin/main..."
git fetch origin main --depth=1

# Check origin/main availability (safety net if fetch fails)
if ! git rev-parse --verify origin/main > /dev/null 2>&1; then
  echo "❌ origin/main not found locally."
  echo "   Run 'git fetch origin main' first, then push again."
  echo "   (If this persists, check your remote configuration.)"
  exit 1
fi

# DCO re-check (L2): every pushed commit must carry a Signed-off-by trailer.
# Runs AFTER the fetch above (the null-SHA first-push fallback depends on origin/main).
# Git passes pushed refs on STDIN: <local-ref> <local-sha> <remote-ref> <remote-sha>
DCO_FAILED=""

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Skip branch deletions — nothing was pushed
  if [ "$REMOTE_SHA" = "(delete)" ] || [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    # First push of a new branch: remote ref does not exist yet.
    # Fall back to commits not yet on origin/main (fetch above guarantees it exists).
    COMMITS=$(git log --no-merges --format="%H" origin/main..HEAD)
  else
    COMMITS=$(git log --no-merges --format="%H" "$REMOTE_REF..$LOCAL_REF")
  fi

  for SHA in $COMMITS; do
    if ! git log -1 --format="%B" "$SHA" | grep -q 'Signed-off-by:'; then
      SHORT=$(git log -1 --format="%h" "$SHA")
      DCO_FAILED="${DCO_FAILED}  - commit $SHORT is missing 'Signed-off-by:' trailer\n"
    fi
  done
done

if [ -n "$DCO_FAILED" ]; then
  echo "❌ DCO: the following commits are missing a Signed-off-by trailer:"
  printf "%b" "$DCO_FAILED"
  echo "   Fix with 'git rebase --signoff origin/main' or amend with 'git commit -s --amend'."
  exit 1
fi
echo "✅ DCO re-check passed (all pushed commits signed off)."

# Scoped tests — MISMO contrato de selección que los jobs de CI
# (`test-unit-client` / `test-unit-server`), a través de los scripts npm.
#
# Por qué el server va unit-scoped (`.unit.test.js`): los tests de integración
# necesitan PostgreSQL, y exigirlos aquí hacía que el gate local fuera MÁS
# estricto que el de CI — sin DB en la máquina no se podía pushear, mientras
# que en CI esos tests ni se ejecutan. La integración se cubre en el job
# `test-integration` de `ci.yml`, que sí levanta el service container.
#
# No añadir `--config` ni flags de reporter aquí: la definición vive en los
# scripts de cada workspace para que local y CI no puedan divergir.
echo "Running scoped tests (server)..."
npm run test:changed --workspace=apps/server || { echo "❌ Server scoped tests failed."; exit 1; }
echo "✅ Server scoped tests passed."

echo "Running scoped tests (client)..."
npm run test:changed --workspace=apps/client || { echo "❌ Client scoped tests failed."; exit 1; }
echo "✅ Client scoped tests passed."