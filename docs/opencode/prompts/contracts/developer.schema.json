{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer Agent Output Contract Schema",
  "description": "Defines required fields for developer agent responses",
  "type": "object",
  "allOf": [
    { "$ref": "base.schema.json" },
    {
      "type": "object",
      "required": ["status", "action", "details"],
      "properties": {
        "status": {
          "type": "string",
          "description": "Overall status of the task execution",
          "enum": ["completed", "in-progress", "blocked", "failed"]
        },
        "action": {
          "type": "string",
          "description": "The specific action taken (e.g., 'implement-task', 'create-file', 'run-tests')"
        },
        "filesChanged": {
          "type": "array",
          "description": "List of files created or modified",
          "items": { "type": "string" }
        },
        "details": {
          "type": "string",
          "description": "Human-readable description of what was done"
        },
        "nextSteps": {
          "type": "array",
          "description": "Recommended next steps for the orchestrator",
          "items": { "type": "string" }
        },
        "taskId": {
          "type": "string",
          "description": "The task ID from tasks.md being implemented"
        },
        "changeName": {
          "type": "string",
          "description": "The OpenSpec change name this task belongs to"
        }
      }
    }
  ],
  "responseTypes": {
    "success": {
      "description": "Task completed successfully",
      "required": ["status", "action", "details"],
      "properties": {
        "status": { "const": "completed" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "filesChanged": { "type": "array", "items": { "type": "string" } },
        "nextSteps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "failure": {
      "description": "Task failed or blocked",
      "required": ["status", "action", "details", "error"],
      "properties": {
        "status": { "enum": ["blocked", "failed"] },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "description": "Machine-readable error code" },
            "message": { "type": "string", "description": "Human-readable error message" },
            "details": { "type": "string", "description": "Additional error context" }
          }
        }
      }
    }
  }
}