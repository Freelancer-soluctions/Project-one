{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Researcher Agent Output Contract Schema",
  "description": "Defines required fields for researcher agent responses",
  "type": "object",
  "allOf": [
    { "$ref": "base.schema.json" },
    {
      "type": "object",
      "required": ["status", "topic", "findings", "details"],
      "properties": {
        "status": {
          "type": "string",
          "description": "Overall status of the research task",
          "enum": ["completed", "partial", "failed"]
        },
        "topic": {
          "type": "string",
          "description": "The research topic or question investigated"
        },
        "findings": {
          "type": "array",
          "description": "Key findings from the research",
          "items": { "type": "string" }
        },
        "details": {
          "type": "string",
          "description": "Human-readable summary of the research performed"
        },
        "recommendation": {
          "type": "string",
          "description": "Primary recommendation based on findings"
        },
        "sources": {
          "type": "array",
          "description": "Sources consulted during research",
          "items": { "type": "string" }
        },
        "alternatives": {
          "type": "array",
          "description": "Alternative approaches or solutions considered",
          "items": {
            "type": "object",
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string", "description": "Name of the alternative" },
              "reason": { "type": "string", "description": "Reason for considering this alternative" }
            }
          }
        },
        "risks": {
          "type": "array",
          "description": "Identified risks or concerns",
          "items": { "type": "string" }
        },
        "nextSteps": {
          "type": "array",
          "description": "Recommended next steps for the orchestrator",
          "items": { "type": "string" }
        }
      }
    }
  ],
  "responseTypes": {
    "success": {
      "description": "Research completed successfully",
      "required": ["status", "topic", "findings", "details"],
      "properties": {
        "status": { "const": "completed" },
        "recommendation": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "failure": {
      "description": "Research partially completed or failed",
      "required": ["status", "topic", "findings", "details", "error"],
      "properties": {
        "status": { "enum": ["partial", "failed"] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "description": "Machine-readable error code" },
            "message": { "type": "string", "description": "Human-readable error message" },
            "details": { "type": "string", "description": "Additional error context" }
          }
        }
      }
    }
  }
}