save-exact=true
legacy-peer-deps=false
engine-strict=true
workspaces-update=true
# include-workspace-root removed: causes npm to run root scripts when invoked from workspace dirs,
# producing 'Missing script: test' noise. Default (false) is correct — all workspace-enabled
# root scripts already use --if-present defensively (build, lint, format, test:watch, etc).
fund=false
audit-level=moderate
