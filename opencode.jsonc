{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "plugins": [
    "@warp-dot-dev/opencode-warp",
    "./.opencode/plugins/output-contracts",
    "./.opencode/plugins/neurosymbolic-guardrails",
    "@slkiser/opencode-quota"
  ],
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B Local"
        }
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute Gateway",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "OmniRoute Auto (smart routing)",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "auto/best-coding": {
          "name": "Best Coding (OmniRoute)",
          "contextWindow": 400000,
          "maxTokens": 8192,
          "capabilities": {
            "vision": true,
            "tool_calling": true
          }
        }
      }
    }
  },
  "default_agent": "main",
  "instructions": ["AGENTS.md", "CONTEXT.md"],
  "shell": "bash",
  "skills": [".opencode/skills", ".agents/skills"],
  "tool_output": {
    "max_lines": 150,
    "max_bytes": 16384
  },
  "lsp": {
    "prisma": {
      "command": ["npx", "@prisma/language-server", "--stdio"],
      "extensions": [".prisma"]
    }
  },
  "mcp": {
    "servers": {
      "composio": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "oauth": {},
        "enabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "enabled": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "coverage/**",
      "build/**"
    ]
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "composio_COMPOSIO_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lsp",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "doom_loop",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "main": {
      "mode": "primary",
      "model": "opencode-go/beam-free",
      "description": "Single main agent: runs SDD lifecycle, implementation, and git workflows directly",
      "system": "{file:docs/opencode/prompts/main.md}",
      "steps": 60,
      "permissions": [
        {
          "action": "bash",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "bash",
          "resource": "git *",
          "effect": "ask"
        },
        {
          "action": "bash",
          "resource": "openspec *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git status",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git diff --stat",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git diff --stat *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git add *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git commit *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "gh *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git log",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git branch",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git branch *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git checkout *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git pull",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git pull *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git fetch",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git fetch *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git diff",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git stash",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git stash *",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git * --no-verify*",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "git push",
          "effect": "ask"
        },
        {
          "action": "bash",
          "resource": "git push *",
          "effect": "ask"
        },
        {
          "action": "bash",
          "resource": "git commit --amend",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "git commit --amend *",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "git rebase",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "git rebase *",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "lsp",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "reviewer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "researcher",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "project-manager",
          "effect": "allow"
        }
      ]
    },
    "reviewer": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode-go/beam-free",
      "description": "Code and spec reviewer",
      "system": "{file:docs/opencode/prompts/reviewer.md}",
      "steps": 50,
      "temperature": 0,
      "permissions": [
        {
          "action": "lsp",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "researcher": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode-go/beam-free",
      "description": "Research agent",
      "system": "{file:docs/opencode/prompts/researcher.md}",
      "steps": 50,
      "permissions": [
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "project-manager": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/mimo-v2.6-flash-free",
      "description": "Handles Trello project-management workflows - card creation, updates, deletion, state transitions",
      "system": "{file:docs/opencode/prompts/project-manager.md}",
      "steps": 15,
      "permissions": [
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "composio_COMPOSIO_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}
