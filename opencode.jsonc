{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "@warp-dot-dev/opencode-warp"
  ],
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434"
        //"timeout":
        //"setCacheKy": (bool)
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B Local",
        },
      }
    }
  },
  //subagents configuration
  "default_agent": "orchestrator",
  "instructions": ["AGENTS.md", "CONTEXT.md"],
  "shell": "bash",
  "skills": {
    "paths": [
      ".opencode/skills",
      ".agents/skills"
    ]
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 65536
  },
  // Formatter disabled by design — formatting is handled by Husky + lint-staged + Prettier
  // in pre-commit hooks. Enabling OpenCode formatter would duplicate this pipeline,
  // formatting files that may never be committed (wasted CPU) and potentially causing
  // conflicts with lint-staged (formatting staged files twice).
  //"formatter": {
  //  "prettier": {
  //    "command": ["npx", "prettier", "--write", "$FILE"],
  //    "extensions": [".js", ".ts", ".jsx", ".tsx", ".json", ".css", ".md", ".mdx", ".yaml", ".yml"]
  //  }
  //},
  // LSP: Prisma validate .prisma schema files (apps/server/prisma/schema.prisma).
  // Requires @prisma/language-server (installed in apps/server v31.11.0).
  "lsp": {
    "prisma": {
      "command": ["npx", "@prisma/language-server", "--stdio"],
      "extensions": [".prisma"]
    }
  },
  "permission": {
    "read": "allow",
    "write": "deny",
    "edit": "deny",
    "bash": "deny",
    "composio_COMPOSIO_*": "deny",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "task": "deny",
    "skill": "allow",
    "lsp": "deny",
    "todowrite": "allow",
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "agent": {
    // OpenCode built-in agents — disabled, not used
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },

    "orchestrator": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "description": "Main orchestrator that delegates tasks to specialized agents",
      "prompt": "{file:docs/opencode/prompts/orchestrator.md}",
      "steps": 45,
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "spec-manager": "allow",
          "planner": "allow",
          "developer": "allow",
          "reviewer": "allow",
          "researcher": "allow",
          "git-manager": "allow",
          "project-manager": "allow"
        }
      }
    },
    "spec-manager": {
      "mode": "subagent",
      "hidden": false,
      "model": "nvidia/minimaxai/minimax-m2.7",
      "description": "Executes OpenSpec CLI - explore, propose, verify, archive",
      "prompt": "{file:docs/opencode/prompts/spec-manager.md}",
      "steps": 15,
      "temperature": 0,
      "permission": {
        "bash": "allow"
      }
    },
    "git-manager": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/big-pickle",
      "description": "SCM and Conventional Commit specialist",
      "prompt": "{file:docs/opencode/prompts/git-manager.md}",
      "steps": 20,
      "permission": {
        "bash": "allow",
        "todowrite": "deny"
      }
    },
    "planner": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/ring-2.6-1t-free",
      "description": "Planning specialist",
      "prompt": "{file:docs/opencode/prompts/planner.md}",
      "steps": 15,
      "temperature": 0,
      "permission": {
        "write": "allow",
        "question": "allow"
      }
    },
    "developer": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/qwen3.6-plus-free",
      "description": "Implementation agent",
      "prompt": "{file:docs/opencode/prompts/developer.md}",
      "steps": 25,
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "lsp": "allow"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/nemotron-3-super-free",
      "description": "Code reviewer",
      "prompt": "{file:docs/opencode/prompts/reviewer.md}",
      "steps": 10,
      "temperature": 0,
      "permission": {
        "lsp": "allow"
      }
    },
    "researcher": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/minimax-m2.5",
      "description": "Research agent",
      "prompt": "{file:docs/opencode/prompts/researcher.md}",
      "steps": 12,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow"
      }
    },
    "project-manager": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Handles Trello project-management workflows - card creation, updates, deletion, state transitions",
      "prompt": "{file:docs/opencode/prompts/project-manager.md}",
      "steps": 15,
      "permission": {
        "question": "allow",
        "bash": "allow",
        "composio_COMPOSIO_*": "allow"
      }
    }
  },
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "oauth": {},
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "coverage/**",
      "build/**"
    ]
  }
}
