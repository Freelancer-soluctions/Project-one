{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "@warp-dot-dev/opencode-warp",
    "./.opencode/plugins/output-contracts.ts",
    "./.opencode/plugins/neurosymbolic-guardrails.ts",
    "@slkiser/opencode-quota"
  ],
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434"
        //"timeout":
        //"setCacheKy": (bool)
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B Local"
        }
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute Gateway",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "OmniRoute Auto (smart routing)",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "auto/best-coding": {
          "name": "Best Coding (OmniRoute)",
          "contextWindow": 400000,
          "maxTokens": 8192,
          "capabilities": {
            "vision": true,
            "tool_calling": true
          }
        }
      }
    }
  },
  //subagents configuration
  "default_agent": "main",
  "instructions": ["AGENTS.md", "CONTEXT.md"],
  // "env": {
  //   "BASH_ENV": "$HOME/.bash_env"
  // },
  "shell": "bash",
  "skills": {
    "paths": [".opencode/skills", ".agents/skills"]
  },
  "tool_output": {
    "max_lines": 150,
    "max_bytes": 16384
  },
  // Formatter disabled by design — formatting is handled by Husky + lint-staged + Prettier
  // in pre-commit hooks. Enabling OpenCode formatter would duplicate this pipeline,
  // formatting files that may never be committed (wasted CPU) and potentially causing
  // conflicts with lint-staged (formatting staged files twice).
  //"formatter": {
  //  "prettier": {
  //    "command": ["npx", "prettier", "--write", "$FILE"],
  //    "extensions": [".js", ".ts", ".jsx", ".tsx", ".json", ".css", ".md", ".mdx", ".yaml", ".yml"]
  //  }
  //},
  // LSP: Prisma validate .prisma schema files (apps/server/prisma/schema.prisma).
  // Requires @prisma/language-server (installed in apps/server v31.11.0).
  "lsp": {
    "prisma": {
      "command": ["npx", "@prisma/language-server", "--stdio"],
      "extensions": [".prisma"]
    }
  },
  "permission": {
    "read": "allow",
    "write": "deny",
    // TODO: restore when PR #27654 merges - parent edit:deny hides subagent tools (bug #26758)
    // "edit": "deny",
    // "bash": "deny",
    "composio_COMPOSIO_*": "deny",
    "context7_*": "deny",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "task": "deny",
    "skill": "allow",
    "lsp": "deny",
    "todowrite": "allow",
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "agent": {
    // OpenCode built-in agents — disabled, not used
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "main": {
      "mode": "primary",
      // Model per phase (Decision 3, single-main-agent): beam-free = coordination/exploration/review (phases 0-2, 5-6).
      // Implementation-heavy phases 3-4 switch to opencode/mimo-v2.6-flash-free via:
      //   1) manual /models selection (fallback), 2) `model:` frontmatter on .opencode/commands/opsx-apply.md,
      //   3) the implementation-protocol skill hint (confirm coding model before coding).
      "model": "opencode-go/beam-free",
      "description": "Single main agent: runs SDD lifecycle, implementation, and git workflows directly",
      "prompt": "{file:docs/opencode/prompts/main.md}",
      "steps": 60,
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        // 15-pattern bash hardening migrated from agent.orchestrator (git-permissions-hardening, e77bd25e);
        // single-main-agent retired orchestrator, so the object is re-homed here. First-match-wins order.
        "bash": {
          "git push": "deny",
          "git push *": "deny",
          "git commit --amend": "deny",
          "git commit --amend *": "deny",
          "git rebase": "deny",
          "git rebase *": "deny",
          "git * --no-verify*": "deny",
          "openspec *": "allow",
          "git status": "allow",
          "git diff --stat": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "gh *": "allow",
          "git *": "deny",
          "*": "ask"
        },
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "question": "allow",
        "context7_*": "ask",
        "task": {
          "*": "deny",
          "reviewer": "allow",
          "researcher": "allow",
          "project-manager": "allow"
        }
      }
    },
    "reviewer": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/mimo-v2.6-flash-free",
      "description": "Code and spec reviewer",
      "prompt": "{file:docs/opencode/prompts/reviewer.md}",
      "steps": 25,
      "temperature": 0,
      "permission": {
        "lsp": "allow",
        "edit": "deny"
      }
    },
    "researcher": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode-go/beam-free",
      "description": "Research agent",
      "prompt": "{file:docs/opencode/prompts/researcher.md}",
      "steps": 20,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "context7_*": "ask",
        "edit": "ask" // workaround: bug #26758 — edit:deny corrompe herencia de read/glob/grep allow del global; ask preserva restriccion (pedira permiso si researcher intenta editar) sin disparar el bug
      }
    },
    "project-manager": {
      "mode": "subagent",
      "hidden": false,
      "model": "opencode/mimo-v2.6-flash-free",
      "description": "Handles Trello project-management workflows - card creation, updates, deletion, state transitions",
      "prompt": "{file:docs/opencode/prompts/project-manager.md}",
      "steps": 15,
      "permission": {
        "question": "allow",
        "bash": "allow",
        "composio_COMPOSIO_*": "allow",
        "edit": "deny"
      }
    }
  },
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      // "headers": {
      //   "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
      // },
      "oauth": {},
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
    // "composio": {
    //   "type": "local",
    //   "command": [
    //     "node",
    //     ".opencode/proxy/index.js",
    //     "--target=composio"
    //   ],
    //   "enabled": true
    // },
    // "context7": {
    //   "type": "local",
    //   "command": [
    //     "node",
    //     ".opencode/proxy/index.js",
    //     "--target=context7"
    //   ],
    //   "enabled": true
    // }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "coverage/**",
      "build/**"
    ]
  }
}
