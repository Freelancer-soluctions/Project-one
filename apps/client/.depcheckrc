ignores:
  - "@storybook/*"
  - "@chromatic-com/storybook"
  - "storybook"
  - "msw"
  - "why-is-node-running"
  - "globals"
  - "autoprefixer"
  - "postcss"
  - "tailwindcss"
  - "tailwindcss-animate"
  - "class-variance-authority"
  - "clsx"
  - "tailwind-merge"
  - "lucide-react"
  - "react-icons"
  - "cmdk"
  - "date-fns"
  - "date-fns-tz"
  - "prop-types"
  - "shadcn-ui"
  - "@tanstack/react-query"
  - "@tanstack/react-query-devtools"
  - "add"
  - "command"
  - "quill"
  - "@vitest/coverage-v8"
ignorePatterns:
  - "dist"
  - "coverage"
  - "node_modules"
  - "public"
  - "src/stories"
  - "*.stories.jsx"
  - "*.stories.js"
  - "*.test.jsx"
  - "*.test.js"
  - "*.spec.jsx"
  - "*.spec.js"
