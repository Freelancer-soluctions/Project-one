{
  "name": "client-react",
  "version": "1.0.0",
  "description": "Front-end application with good practices using react shadcn and tailwind",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "lint": "eslint \"**/*.{js,jsx}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{js,jsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=junit --reporter=json --reporter=../../scripts/ci/vitest-flaky-reporter.mjs --outputFile.junit=reports/junit.xml --outputFile.json=reports/vitest-results.json",
    "test:changed:ci": "vitest run --changed origin/main --coverage --reporter=default --reporter=junit --reporter=json --reporter=../../scripts/ci/vitest-flaky-reporter.mjs --outputFile.junit=reports/junit.xml --outputFile.json=reports/vitest-results.json"
  },
