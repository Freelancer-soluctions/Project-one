    "src/modules/expenses/utils/enums.js": ["exports"],
    "src/modules/news/utils/adapters.js": ["exports"],
    "src/modules/products/utils/currencyFormat.js": ["exports"],
    "src/modules/providerOrder/api/providerOrderApi.js": ["exports"],
