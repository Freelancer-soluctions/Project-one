ignores:
  - "@prisma/language-server"
  - "@vitest/ui"
  - "nodemon"
  - "why-is-node-running"
  - "supertest"
  - "prisma"
  - "vite"
  - "swagger-jsdoc"
  - "swagger-ui-express"
  - "knex"
  - "@vitest/coverage-v8"
ignorePatterns:
  - "tests"
  - "reports"
  - "node_modules"
  - "prisma"
  - "*.test.js"
  - "*.spec.js"
