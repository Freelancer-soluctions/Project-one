{
  "name": "server-express",
  "version": "1.0.0",
  "description": "Back-end application with good practices using node.js and express",
  "main": "src/bin/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nodemon src/bin/index.js",
    "build": "echo 'No build step needed for Express'",
    "postinstall": "prisma generate ",
    "prisma-migration": "prisma migrate dev",
    "prisma-seed": "prisma db seed",
    "prisma-push": "prisma db push",
    "prisma-pull": "prisma db pull",
    "test": "concurrently -m 1 --success first -n unit,integration -c cyan,yellow \"npm run test:unit --if-present\" \"npm run test:integration --if-present\"",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run \".unit.test.js\"",
    "test:integration": "vitest run \".integration.test.js\"",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.js",
    "test:smoke:ci": "vitest run --config vitest.smoke.config.js --reporter=junit",
    "test:regression": "vitest run --config vitest.config.js",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "lint": "eslint \"**/*.js\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.js\" --fix"
  },
  "author": "Johan Garcia",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.950.0",
    "@prisma/client": "^5.16.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "vite": "7.3.1",
    "winston": "^3.13.0",
    "zxcvbn": "^4.4.2",
    "@socket.io/redis-adapter": "^8.3.0"
  },
  "devDependencies": {
    "@prisma/language-server": "^31.11.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "nodemon": "^3.1.0",
    "prisma": "^5.17.0",
    "supertest": "^7.0.0",
    "vitest": "^4.0.18",
    "why-is-node-running": "^3.1.0"
  }
}
