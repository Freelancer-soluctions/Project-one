{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.cache/tsc/tsconfig.tsbuildinfo",
    "noEmit": false,
    "allowJs": false,
    "checkJs": false,
    "incremental": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".cache"]
}