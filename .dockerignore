# Root .dockerignore for monorepo-root context builds
# Prevents contamination of build context (node_modules symlinks, etc.)
# Authoritative .dockerignore for all monorepo Docker builds (replaces apps/server/.dockerignore)

node_modules
.git
.env
.env.*
.github
openspec
docs
reports
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store
.turbo
.vercel
.netlify
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.husky
.vscode
.idea
*.pem
*.key
*.crt
*.p12
*.pfx
dist
coverage

# Tests (from apps/server/.dockerignore)
tests
**/*.test.js
**/*.spec.js

# Build outputs (from apps/server/.dockerignore)
build

# IDE/Editor (from apps/server/.dockerignore)
*.swp
*.swo

# OS (from apps/server/.dockerignore)
.DS_Store
Thumbs.db

# Git (from apps/server/.dockerignore)
.git
.gitignore

# Prisma - migrations INTENTIONALLY NOT excluded (must be in image for migrate deploy)
# prisma/migrations

# Docker (from apps/server/.dockerignore)
Dockerfile*
docker-compose*.yml
.dockerignore

# Misc (from apps/server/.dockerignore)
*.md
!.github